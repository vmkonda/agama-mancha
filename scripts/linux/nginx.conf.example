# Agama Mancha behind nginx. Replace the host name and certificate paths (certbot, say).
server {
    listen 443 ssl http2;
    server_name agama.example.org;
    ssl_certificate     /etc/letsencrypt/live/agama.example.org/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/agama.example.org/privkey.pem;

    client_max_body_size 20m;
    location / {
        proxy_pass http://127.0.0.1:8770;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;    # marks the session cookie Secure
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 120s;                       # listeners and workers wait up to 55 s
    }
}
server {
    listen 80;
    server_name agama.example.org;
    return 301 https://$host$request_uri;
}
